# {{ ansible_managed }}
# First-boot network only. Ansible (role "network") takes over netplan afterwards.
version: 2
ethernets:
  lan:
    match:
      name: "{{ public_interface_match }}"
    dhcp4: false
    mtu: {{ public_mtu }}
    addresses:
      - {{ ansible_host }}/{{ public_network.split('/')[1] }}
    routes:
      - to: default
        via: {{ public_gateway }}
    nameservers:
      addresses: [{{ dns_servers | join(', ') }}]
      search: [{{ domain }}]
