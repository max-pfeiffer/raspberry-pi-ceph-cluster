---
profile: production
# Use the collections installed by `make deps` instead of downloading its own copy.
offline: true
exclude_paths:
  - .venv/
  - collections/
  - build/
  - .github/
  - .idea/
  - playbooks/templates/
  - roles/*/templates/
  # Encrypted with ansible-vault: not YAML on disk, and the linter has no vault password.
  - inventory/group_vars/all/vault.yml
skip_list:
  # Variables like ceph_version or cephadm_path are deliberately shared between roles.
  - var-naming[no-role-prefix]
