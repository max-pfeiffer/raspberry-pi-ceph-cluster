---
# Copy to vault.yml, encrypt the copy, then set the values in the encrypted file:
#   cp inventory/group_vars/all/vault.yml.example inventory/group_vars/all/vault.yml
#   uv run ansible-vault encrypt inventory/group_vars/all/vault.yml
#   uv run ansible-vault edit inventory/group_vars/all/vault.yml
# vault.yml is git-ignored: keep it out of a public repo (see README).
vault_ceph_dashboard_password: "change-me-to-something-long"
# Optional: creates the Grafana admin user when Grafana is first deployed.
# vault_ceph_grafana_password: "change-me-too"
