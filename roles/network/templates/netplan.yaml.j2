# {{ ansible_managed }}
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ public_interface }}:
      dhcp4: false
      addresses:
        - {{ ansible_host }}/{{ public_network.split('/')[1] }}
      routes:
        - to: default
          via: {{ public_gateway }}
      nameservers:
        addresses: [{{ dns_servers | join(', ') }}]
        search: [{{ domain }}]
    {{ cluster_interface }}:
      match:
        macaddress: "{{ cluster_nic_mac | lower }}"
      set-name: {{ cluster_interface }}
      dhcp4: false
      mtu: {{ cluster_mtu }}
      addresses:
        - {{ cluster_ip }}/{{ cluster_network.split('/')[1] }}
