# {{ ansible_managed }}
{% for host in groups['ceph'] %}
---
service_type: host
hostname: {{ host }}
addr: {{ hostvars[host].ansible_host }}
labels: {{ (hostvars[host].ceph_host_labels + hostvars[host].ceph_host_extra_labels) | to_json }}
{% endfor %}
---
service_type: mon
placement:
  label: mon
---
service_type: mgr
placement:
  label: mgr
  count: {{ ceph_mgr_count }}
---
service_type: crash
placement:
  host_pattern: "*"
---
service_type: osd
service_id: nvme
placement:
  label: osd
spec:
  data_devices:
    model: "{{ ceph_osd_device_model }}"
{% if ceph_monitoring_enabled %}
---
service_type: node-exporter
placement:
  host_pattern: "*"
---
service_type: ceph-exporter
placement:
  host_pattern: "*"
---
service_type: prometheus
placement:
  label: monitoring
  count: 1
spec:
  retention_time: "{{ ceph_prometheus_retention_time }}"
---
service_type: grafana
placement:
  label: monitoring
  count: 1
---
service_type: alertmanager
placement:
  label: monitoring
  count: 1
{% endif %}
