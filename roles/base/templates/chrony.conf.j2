# {{ ansible_managed }}
{% for pool in ntp_pools %}
pool {{ pool }} iburst maxsources 4
{% endfor %}

driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
# Step the clock on the first updates after boot (the Pi has no RTC battery by default).
makestep 1 3
leapsectz right/UTC
